#!/usr/bin/env bash
set -eu
shell_bin=$(command -v quickshell || command -v qs || true)
[[ -n "$shell_bin" ]] || { printf 'Quickshell is not installed.\n' >&2; exit 1; }
case "${1:-}" in
    topbar) method=toggleBar; args=() ;;
    settings) method=settings; args=() ;;
    displays) method=displays; args=() ;;
    calendar|notifications|audio|wifi|bluetooth|battery|power) method=toggleMenu; args=("$1") ;;
    *) printf 'Unknown Hyprshell shortcut.\n' >&2; exit 1 ;;
esac
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
if timeout 3 "$shell_bin" ipc --path "$config" call bar "$method" "${args[@]}" 2>/dev/null; then
    exit 0
fi
"$HOME/.local/bin/start-quickshell-bar" --require-quickshell
exec "$shell_bin" ipc --path "$config" call bar "$method" "${args[@]}"
