#!/usr/bin/env bash
# Session launcher only. The bar and all dropdown logic run in QML.
set -u
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
mkdir -p -- "$state_dir"
shell_bin=$(command -v quickshell || command -v qs || true)
startup_failed() {
    printf 'Quickshell did not start. See %s/bar.log\n' "$state_dir" >&2
    exit 1
}
[[ -n "$shell_bin" ]] || startup_failed
export QT_QPA_PLATFORM=wayland
deadline=$((SECONDS + 30))
next_launch=0
while (( SECONDS < deadline )); do
    # A just-killed instance can remain registered until its shutdown finishes.
    if (( SECONDS >= next_launch )); then
        timeout 5 "$shell_bin" --no-duplicate --daemonize --path "$config" >>"$state_dir/bar.log" 2>&1 || true
        next_launch=$((SECONDS + 2))
    fi
    if [[ $(timeout 2 "$shell_bin" ipc --path "$config" call bar ready 2>/dev/null) == true ]]; then
        # Readiness can precede registration of the notification service.
        shell_pid=$(timeout 2 "$shell_bin" list --path "$config" --json | sed -n 's/.*"pid": *\([0-9][0-9]*\).*/\1/p' | head -1)
        owner_pid=
        read -r _owner_type owner_pid < <(timeout 2 busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID s org.freedesktop.Notifications 2>/dev/null) || true
        if [[ -n "$shell_pid" && "$owner_pid" == "$shell_pid" ]]; then
            exit 0
        fi
    fi
    sleep 0.25
done
timeout 5 "$shell_bin" kill --path "$config" >>"$state_dir/bar.log" 2>&1 || true
startup_failed
